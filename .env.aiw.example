# =============================================================================
# AI Whisperers Code Agent UI — environment template
# =============================================================================
# Don't fill these in by hand. Run:
#
#     ../code-agent/scripts/aiw-fetch-secrets.sh --frontend > .env.local
#
# That script pulls live values from Bitwarden via the VPS.

# --- Backend API ---
VITE_API_URL=http://localhost:8080/api

# --- Auth: Supabase (replaces Keycloak) ---
# Note: until integration:supabase-auth lands, the upstream Keycloak vars below
# are still wired in by the upstream code. Either set them or live with broken
# auth in dev (the dev profile bypasses auth).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Git platform link (for repo links in the UI) ---
VITE_GIT_PLATFORM=github
VITE_GITHUB_URL=https://github.com

# --- Legacy Keycloak vars (still referenced by upstream code) ---
VITE_KEYCLOAK_URL=
VITE_KEYCLOAK_REALM=code-agent
VITE_KEYCLOAK_CLIENT_ID=code-agent-ui
VITE_KEYCLOAK_IDP_HINT=
VITE_BITBUCKET_URL=https://bitbucket.org
